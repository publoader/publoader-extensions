{
  "name": "publoader-ext-mangaplus",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "publoader extension for MangaPlus by Shueisha (extension API v2)",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
