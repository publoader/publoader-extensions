{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  // Tests are checked by tsconfig.test.json instead: they are the only files
  // allowed to see Node's globals, so the extension itself cannot reach for
  // them by accident.
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
